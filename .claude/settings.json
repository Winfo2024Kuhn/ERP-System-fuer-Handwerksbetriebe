{
  "enabledPlugins": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.graphify-venv/Scripts/graphify.exe",
            "args": [
              "hook-guard",
              "search"
            ]
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.graphify-venv/Scripts/graphify.exe",
            "args": [
              "hook-guard",
              "read",
              "--strict"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/scripts/claude-cloud/setup.sh\" --session",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
