# ============================================================
# Lokale Konfiguration (NICHT committen!)
# Kopiere diese Datei nach: application-local.properties
# und trage deine individuellen Werte ein.
# ============================================================

# ========== Datenbank ==========
# PostgreSQL 16, z. B. als Container:
#   docker run -d --name erp-dev-pg -p 127.0.0.1:5432:5432 -e POSTGRES_DB=kalkulationsprogramm_db -e POSTGRES_USER=erp_user -e POSTGRES_PASSWORD=DEIN_DB_PASSWORT postgres:16
# Eine leere Datenbank bekommt beim ersten Start Basis-Schema und Migrationen automatisch.
spring.datasource.url=jdbc:postgresql://localhost:5432/kalkulationsprogramm_db
spring.datasource.username=DEIN_DB_BENUTZERNAME
spring.datasource.password=DEIN_DB_PASSWORT

# ========== E-Mail (SMTP/IMAP) und Gemini API Key ==========
# Diese Werte werden NICHT mehr in Properties hinterlegt.
# Trage sie nach dem ersten Start in der UI unter
#   System-Einstellungen → E-Mail-Konto / KI Gemini
# ein – sie werden in der Datenbank-Tabelle system_setting gespeichert
# und können dort jederzeit ohne Backend-Neustart geändert werden.

# ========== HiCAD Netzwerkpfade (optional) ==========
#hicad.network-url=\\\\DEIN_SERVER\\CADdrawings
#hicad.network-drive-letter=Z:

# ========== Zeiterfassung PWA Base-URL (optional) ==========
# Adresse für die QR-Codes der Handy-App, ohne /zeiterfassung und ohne Schrägstrich am Ende.
# Mit Tailscale Funnel (docs/INSTALLATION.md, Variante 1b) z. B.:
#zeiterfassung.base-url=https://erp-rechner.tail-xxxx.ts.net

# ========== Vendor Integrations (optional) ==========
#vendor.microsoft.enabled=true
#vendor.microsoft.tenant-id=DEIN_TENANT_ID
#vendor.microsoft.client-id=DEIN_CLIENT_ID
#vendor.microsoft.client-secret=DEIN_CLIENT_SECRET
#vendor.microsoft.billing-account-id=DEIN_BILLING_ACCOUNT_ID

#vendor.amazon.enabled=true
#vendor.amazon.client-id=DEIN_CLIENT_ID
#vendor.amazon.client-secret=DEIN_CLIENT_SECRET
#vendor.amazon.refresh-token=DEIN_REFRESH_TOKEN

# ========== Website-Beitraege (Bereich "Aktuelles" auf der Firmen-Website) ==========
# Gemeinsames Passwort zwischen ERP und Website. Du erfindest es selbst, z.B.
# auf dem Website-Server mit "uuidgen" oder "openssl rand -base64 32".
# Derselbe Wert muss auf dem Website-Server in deren .env unter
# BEITRAEGE_API_TOKEN stehen, sonst antwortet die Website mit "nicht autorisiert".
#
# Warum ueberhaupt ein Passwort, wenn beide Server ueber Tailscale verbunden sind:
# Die Website muss oeffentlich erreichbar sein, sonst kann sie niemand aufrufen.
# Ihre interne Schnittstelle laeuft auf demselben Port wie die oeffentliche Seite.
# Ohne dieses Passwort koennte jeder im Internet Beitraege veroeffentlichen.
#website.beitraege.api-token=DEIN_GEMEINSAMES_PASSWORT

# Adresse der Website fuer die Beitraege-Schnittstelle. Muss https sein.
# Nur noetig, wenn sie von der Website in den Firmendaten abweicht - dort steht
# die oeffentliche Adresse, die auch auf Belegexporte gedruckt wird.
#website.beitraege.base-url=https://deine-firmen-website.de

# ========== Website -> ERP (Anfrage-Formular, Freigabe-Seite, Analytics) ==========
# Gemeinsames Passwort, mit dem sich die Website beim ERP ausweist (Header
# X-ERP-Website-Key). Ohne Passwort weist das ERP diese Aufrufe mit 401 ab - sonst
# koennte jedes Geraet im Firmen- oder Tailscale-Netz Anfragen anlegen und Angebote
# annehmen. Erzeugen mit "openssl rand -base64 32". Derselbe Wert steht auf dem
# Website-Server in deren .env unter ERP_INTERNAL_API_KEY.
#website.internal-api.key=DEIN_GEMEINSAMES_PASSWORT

# ========== Zugriff fremder Webseiten auf das ERP (CORS) ==========
# Normalerweise leer lassen: Die eigene Oberflaeche, die Handy-App, der Vite-Dev-Server
# und die Website (Server zu Server) brauchen keinen Eintrag. Nur wenn eine ANDERE
# Webseite im Browser direkt Daten aus dem ERP lesen soll, ihre genaue Adresse eintragen
# (mehrere mit Komma). Kein "*" - das wird ignoriert. Aendern darf sie nichts, und die
# Anmeldung geht nur mit, wenn sie unter derselben Domain laeuft wie das ERP. Sie muss
# einfache GETs ohne eigene Header schicken.
#app.cors.allowed-origins=https://intranet.deine-firma.de

# ========== Digitale Annahme von Angeboten (Freigabe-Links) ==========
# Oeffentliche Adresse, unter der Kunden Angebote und Auftragsbestaetigungen
# digital annehmen (Freigabe-Seite, z.B. auf der Firmen-Website). Ohne Eintrag
# gehen diese Mails ohne Annahme-Link raus; beim Start steht dann ein Hinweis im Log.
#freigabe.public-base-url=https://deine-firmen-website.de
