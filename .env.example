# ========== Docker Umgebungsvariablen ==========
# Diese Datei kopieren nach .env und Werte anpassen
# cp .env.example .env

# PostgreSQL-Datenbank (Dienst "postgres" in docker-compose.yml)
# Benutzer und Passwort gelten für die Datenbank UND für die App.
# DB_USER=erp_user
# DB_PASSWORD=CHANGE_ME_DB_PW

# Optional: PostgreSQL woanders statt im Container (Beispiel).
# DB_USER/DB_PASSWORD oben gelten dann für diese Datenbank.
# APP_DB_URL=jdbc:postgresql://host.docker.internal:5432/kalkulationsprogramm_db

# Admin-Zugangsdaten (OPTIONAL – nur für Server-Betrieb)
# Standard: NICHTS setzen. Der erste Nutzer, der die Seite im
# Browser öffnet, registriert sich selbst und wird automatisch Admin.
# Nur wenn beide Werte gesetzt sind, legt der Server den Admin vorab an.
# APP_ADMIN_USER=admin
# APP_ADMIN_PASS=change_me_strong_password

# Hinweis: SMTP/IMAP-Zugangsdaten und der Gemini API Key werden NICHT mehr
# über Umgebungsvariablen konfiguriert. Trage sie nach dem ersten Start
# direkt in der Web-UI unter
#   System-Einstellungen → E-Mail-Konto / KI Gemini
# ein – sie werden in der Datenbank gespeichert.

# ========== OPTIONALE INTEGRATIONEN ==========

# Optional: Zeiterfassung URL
# ZEITERFASSUNG_URL=http://localhost:8080

# Optional: Website-Beiträge API
# Bearer-Token für die geschützte Beiträge-API der Website
# (Die Basis-URL wird aus den Firmendaten/Firma-Seite im ERP gelesen)
# WEBSITE_BEITRAEGE_API_TOKEN=your-secret-token-here

# Optional: Digitale Annahme von Angeboten
# Öffentliche Adresse der Freigabe-Seite (z.B. die Firmen-Website). Ohne Eintrag
# gehen Angebote und Auftragsbestätigungen ohne Annahme-Link raus.
# FREIGABE_PUBLIC_BASE_URL=https://deine-firmen-website.de
