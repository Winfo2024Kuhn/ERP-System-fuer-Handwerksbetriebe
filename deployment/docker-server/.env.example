# =============================================================================
# ERP Handwerk - Einstellungen fuer diesen Firmenserver
# =============================================================================
# Wird beim Einrichten automatisch als .env angelegt - mit zufaelligen
# Passwoertern (Einrichten.cmd unter Windows, einrichten.sh unter Linux).
# Die .env enthaelt Passwoerter: nie committen, nie per Mail verschicken.
# Format: KEY=Wert, ohne Leerzeichen um das "=" und ohne Anfuehrungszeichen.
# =============================================================================

# ---------- Datenbank ----------
# Welche Datenbank laeuft: postgres (Standard fuer Kunden) oder mysql (eigener
# Server). Wird beim Einrichten festgelegt - NICHT nachtraeglich umstellen:
# Die Daten liegen in der jeweiligen Datenbank und ziehen nicht mit um.
COMPOSE_PROFILES=postgres
# Lange, zufaellige Passwoerter, z.B. erzeugt mit:  openssl rand -base64 24
# DB_ROOT_PASSWORD: Datenbank-Verwalter (MySQL root bzw. PostgreSQL postgres) -
# nur fuer Wartung, Sicherung und Rollback. Das ERP nutzt DB_USER/DB_PASSWORD.
# DB_USER darf nicht "postgres" oder "root" heissen.
DB_PASSWORD=CHANGE_ME_DB_PW
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PW
DB_USER=erp_user

# ---------- App ----------
# Port, unter dem das ERP im Firmennetz erreichbar ist
APP_PORT=8080
# Auf welcher Adresse der Port lauscht. 0.0.0.0 = im ganzen Firmennetz,
# 127.0.0.1 = nur auf diesem Rechner (Zugriff dann nur ueber einen Proxy
# davor, z. B. "tailscale serve" - die sicherste Variante).
APP_ADRESSE=0.0.0.0
# Sitzt ein Proxy auf diesem Rechner davor (tailscale serve, cloudflared)?
# ja = das ERP glaubt ihm die echte Absender-Adresse. NUR zusammen mit
# APP_ADRESSE=127.0.0.1 - sonst koennte sich jeder im LAN als beliebige
# Adresse ausgeben.
LOKALER_PROXY=nein
# Optional: Admin vorab anlegen. Leer lassen = der erste Nutzer im Browser wird Admin.
APP_ADMIN_USER=
APP_ADMIN_PASS=
# Optional: Adresse der Zeiterfassung fuer QR-Codes / Links
ZEITERFASSUNG_URL=http://localhost:8080
# Optional: oeffentliche Adresse fuer die digitale Annahme von Angeboten
FREIGABE_PUBLIC_BASE_URL=
# Optional: Uploads in einem vorhandenen Ordner auf diesem Rechner statt im
# Docker-Volume, z. B. wenn der Ordner im Firmennetz freigegeben ist.
# Windows (Docker Desktop): Laufwerk als /run/desktop/mnt/host/<buchstabe>/...
#   UPLOADS_ORDNER=/run/desktop/mnt/host/c/Kalkulationsprogramm/uploads
# (diese Schreibweise versteht auch der Updater). Leer = Docker-Volume.
UPLOADS_ORDNER=
# Weitere Einstellungen des ERP (API-Schluessel, Funktionen ...) gehoeren in
# die Datei app.env neben dieser - Vorlage und Erklaerung: app.env.example

# ---------- Netzsperre ----------
# ja = das ERP darf ins Internet, aber nicht ins Firmennetz (PCs, Drucker,
# Dateifreigaben, dieser Rechner selbst). Empfohlen.
NETZSPERRE=ja
# Was das ERP im Firmennetz trotzdem erreichen darf: ziel:port, Komma-
# getrennt. fritz.box:49000 = Anrufliste und Anrufbeantworter der FRITZ!Box.
# Leer = gar nichts im Firmennetz.
NETZSPERRE_AUSNAHMEN=fritz.box:49000

# ---------- Nachtupdate ----------
# Woher die neue Version kommt. ":stable" ist der Stand, den GitHub nach
# gruenen Tests freigibt. Eine Version festhalten: ...:sha-<commit>
ERP_IMAGE=ghcr.io/winfo2024kuhn/erp-system-fuer-handwerksbetriebe:stable

# Wann der Updater nach neuen Versionen schaut (cron-Format, Ortszeit).
# Standard: jede Nacht um 3 Uhr.
UPDATE_ZEITPLAN=0 3 * * *

# Name des Betriebs - steht in der Handy-Nachricht, damit du weisst, welcher
# Kunde betroffen ist.
KUNDE_NAME=Musterbetrieb

# Wie lange die neue Version nach dem Start Zeit bekommt, bis /actuator/health
# mit 200 antwortet. Spring Boot + Migrationen auf einer grossen Datenbank
# brauchen spuerbar mehr als eine Minute - zu knapp heisst: unnoetige Rollbacks.
HEALTH_WARTEZEIT_SEKUNDEN=300

# Wie viele Sicherungen von vor den Updates aufbewahrt werden
SICHERUNGEN_BEHALTEN=14

# Handy-Nachricht per Webhook. Empfohlen: ntfy (kostenlose App fuer Android/iOS).
#   WEBHOOK_URL=https://ntfy.sh/<langer-zufaelliger-themenname>
# Der Themenname ist wie ein Passwort - jeder, der ihn kennt, liest mit.
# Besser: eigener ntfy-Server oder ntfy-Konto mit Zugriffstoken (WEBHOOK_TOKEN).
# Slack/Mattermost: WEBHOOK_FORMAT=json (sendet {"text": "..."}).
# Leer lassen = keine Nachrichten, nur Logdatei.
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_FORMAT=ntfy
# Auch bei erfolgreichem Update eine (leise) Nachricht schicken? ja / nein
WEBHOOK_BEI_ERFOLG=nein
# Die wichtigsten Fehlerzeilen mitschicken? ja / nein
# Werte in Anfuehrungszeichen, {...}-Inhalte, E-Mail- und IP-Adressen werden
# geschwaerzt; ganz ausschliessen laesst sich Personenbezug in Fehlermeldungen
# aber nicht. Bei einem fremden Dienst (z.B. ntfy.sh) ist das Auftrags-
# verarbeitung (DSGVO) - dann lieber eigener ntfy-Server oder "nein".
WEBHOOK_MIT_FEHLERAUSZUG=nein
