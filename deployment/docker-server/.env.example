# =============================================================================
# ERP Handwerk - Einstellungen fuer diesen Firmenserver
# =============================================================================
# Wird beim Einrichten automatisch als .env angelegt - mit zufaelligen
# Passwoertern (Einrichten.cmd unter Windows, einrichten.sh unter Linux).
# Die .env enthaelt Passwoerter: nie committen, nie per Mail verschicken.
# Format: KEY=Wert, ohne Leerzeichen um das "=" und ohne Anfuehrungszeichen.
# =============================================================================

# ---------- Datenbank (PostgreSQL) ----------
# Lange, zufaellige Passwoerter, z.B. erzeugt mit:  openssl rand -base64 24
# DB_ROOT_PASSWORD: Datenbank-Verwalter (Benutzer "postgres") - nur fuer
# Wartung, Sicherung und Rollback. Das ERP nutzt DB_USER/DB_PASSWORD.
# DB_USER darf nicht "postgres" oder "root" heissen.
# Aeltere .env-Dateien enthalten noch COMPOSE_PROFILES=postgres - die Zeile
# schadet nicht und darf bleiben.
DB_PASSWORD=CHANGE_ME_DB_PW
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PW
DB_USER=erp_user

# ---------- App ----------
# Port, unter dem das ERP im Firmennetz erreichbar ist
APP_PORT=8080
# Auf welcher Adresse der Port lauscht. 0.0.0.0 = im ganzen Firmennetz,
# 127.0.0.1 = nur auf diesem Rechner (Zugriff dann nur ueber einen Proxy
# davor, z. B. "tailscale serve" - die sicherste Variante).
APP_ADRESSE=0.0.0.0
# Sitzt ein Proxy auf diesem Rechner davor (tailscale serve, cloudflared)?
# ja = das ERP glaubt ihm die echte Absender-Adresse. NUR zusammen mit
# APP_ADRESSE=127.0.0.1 - sonst koennte sich jeder im LAN als beliebige
# Adresse ausgeben.
LOKALER_PROXY=nein
# Optional: Admin vorab anlegen. Leer lassen = der erste Nutzer im Browser wird Admin.
APP_ADMIN_USER=
APP_ADMIN_PASS=
# Optional: Adresse der Zeiterfassung fuer QR-Codes / Links
ZEITERFASSUNG_URL=http://localhost:8080
# Optional: oeffentliche Adresse fuer die digitale Annahme von Angeboten
FREIGABE_PUBLIC_BASE_URL=
# Optional: Uploads in einem vorhandenen Ordner auf diesem Rechner statt im
# Docker-Volume, z. B. wenn der Ordner per Windows im Firmennetz freigegeben ist.
# Windows (Docker Desktop): Laufwerk als /run/desktop/mnt/host/<buchstabe>/...
#   UPLOADS_ORDNER=/run/desktop/mnt/host/c/Kalkulationsprogramm/uploads
# (diese Schreibweise versteht auch der Updater). Leer = Docker-Volume (empfohlen;
# freigeben laesst es sich mit der Ordner-Freigabe unten). Umziehen aus einem Ordner:
#   docker compose exec updater bash /erp/dateifreigabe.sh --umziehen
UPLOADS_ORDNER=

# ---------- Ordner-Freigabe (Excel, HiCAD, Tenado direkt oeffnen) ----------
# Gibt den Zeichnungs-Ordner der Uploads ueber Tailscale frei - im Buero und
# unterwegs, ohne Windows-Freigabe (README, Abschnitt "Ordner-Freigabe ohne
# Windows"). Einschalten, starten und anmelden in einem Schritt:
#   docker compose exec updater bash /erp/dateifreigabe.sh
# Das Skript traegt dabei COMPOSE_PROFILES=dateifreigabe hier ein.
# Alles Folgende ist optional:
# Geraetename im Tailscale-Netz (die PCs erreichen den Ordner als
# \\<name>.<tailnet>.ts.net\<ordner>)
DATEIFREIGABE_NAME=erp-dateien
# Freigegebener Unterordner der Uploads - der Datei-Ordner des ERP
DATEIFREIGABE_ORDNER=CADdrawings
# Tag des Geraets fuer die Tailscale-Regeln (muss unter tagOwners stehen).
# Leer = ohne Tag; dann gehoert es dem Konto, das die Anmeldung bestaetigt.
DATEIFREIGABE_TAG=tag:erp-dateien
# Tailscale-Schluessel fuer die erste Anmeldung ohne Link (Admin-Konsole ->
# Settings -> Keys, mit Tag). Leer = Anmelde-Link im Log. Nach der Anmeldung
# wird er nicht mehr gebraucht und darf wieder raus.
DATEIFREIGABE_TS_AUTHKEY=
# Passwort fuer den Ordner. Leer = der Container erzeugt einmal ein zufaelliges
# und merkt es sich; die Einrichtung des Hilfsprogramms bringt es an die PCs.
DATEIFREIGABE_PASSWORT=
# UDP-Port fuer direkte Tailscale-Verbindungen (nicht 41641 - den nutzt oft
# schon Tailscale auf diesem Rechner)
DATEIFREIGABE_UDP_PORT=41642
# Weitere Einstellungen des ERP (API-Schluessel, Funktionen ...) gehoeren in
# die Datei app.env neben dieser - Erklaerung: README, Abschnitt "Weitere Einstellungen: app.env"

# ---------- Netzsperre ----------
# ja = das ERP darf ins Internet, aber nicht ins Firmennetz (PCs, Drucker,
# Dateifreigaben, dieser Rechner selbst). Empfohlen.
NETZSPERRE=ja
# Was das ERP im Firmennetz trotzdem erreichen darf: ziel:port, Komma-
# getrennt. FRITZ!Box: fritz.box:49000 = Anrufliste und Anrufbeantworter,
# fritz.box:1012 = Anrufmonitor (Anruf-Fenster, wenn das Telefon klingelt).
# Steht in den Telefon-Einstellungen des ERP eine andere Adresse als
# fritz.box (z. B. 192.168.178.1), hier dieselbe Adresse eintragen.
# Leer = gar nichts im Firmennetz.
NETZSPERRE_AUSNAHMEN=fritz.box:49000,fritz.box:1012

# ---------- Taegliche Sicherung ----------
# Wann gesichert wird (cron-Format, Ortszeit). Standard: jede Nacht um 2 Uhr.
SICHERUNG_ZEITPLAN=0 2 * * *
# Wohin zusaetzlich zu diesem Rechner gesichert wird (Datenbank nach db/,
# hochgeladene Dateien nach uploads/). Leer = nicht benutzt. Mindestens eines
# eintragen - sonst ist bei einem Plattenausfall alles weg, und das ERP meldet
# es Admins jeden Tag.
# Windows (Docker Desktop): Laufwerk als /run/desktop/mnt/host/<buchstabe>/...
#   SICHERUNG_PLATTE=/run/desktop/mnt/host/f/Kalkulationsprogramm-Backup
#   SICHERUNG_CLOUD=/run/desktop/mnt/host/c/Users/<name>/OneDrive/backup_handwerkerprogramm
# Linux: z. B. /media/sicherung/erp bzw. ein eingebundenes Netzlaufwerk.
# Nach dem Eintragen: docker compose up -d updater, dann einmal
#   docker compose exec updater bash /erp/sicherung.sh --ziele-einrichten
SICHERUNG_PLATTE=
SICHERUNG_CLOUD=
# Wie viele Tage die taeglichen Sicherungen aufbewahrt werden (hier und in den Zielen)
SICHERUNG_TAGE=30

# ---------- Nachtupdate ----------
# Woher die neue Version kommt. ":stable" ist der Stand, den GitHub nach
# gruenen Tests freigibt. Eine Version festhalten: ...:sha-<commit>
ERP_IMAGE=ghcr.io/winfo2024kuhn/erp-system-fuer-handwerksbetriebe:stable

# Wann der Updater nach neuen Versionen schaut (cron-Format, Ortszeit).
# Standard: jede Nacht um 3 Uhr.
UPDATE_ZEITPLAN=0 3 * * *

# Name des Betriebs - steht in der Handy-Nachricht, damit du weisst, welcher
# Kunde betroffen ist.
KUNDE_NAME=Musterbetrieb

# Wie lange die neue Version nach dem Start Zeit bekommt, bis /actuator/health
# mit 200 antwortet. Spring Boot + Migrationen auf einer grossen Datenbank
# brauchen spuerbar mehr als eine Minute - zu knapp heisst: unnoetige Rollbacks.
HEALTH_WARTEZEIT_SEKUNDEN=300

# Wie viele Sicherungen von vor den Updates aufbewahrt werden
SICHERUNGEN_BEHALTEN=14

# Handy-Nachricht per Webhook. Empfohlen: ntfy (kostenlose App fuer Android/iOS).
#   WEBHOOK_URL=https://ntfy.sh/<langer-zufaelliger-themenname>
# Der Themenname ist wie ein Passwort - jeder, der ihn kennt, liest mit.
# Besser: eigener ntfy-Server oder ntfy-Konto mit Zugriffstoken (WEBHOOK_TOKEN).
# Slack/Mattermost: WEBHOOK_FORMAT=json (sendet {"text": "..."}).
# Leer lassen = keine Nachrichten, nur Logdatei.
WEBHOOK_URL=
WEBHOOK_TOKEN=
WEBHOOK_FORMAT=ntfy
# Auch bei erfolgreichem Update bzw. erfolgreicher Sicherung eine (leise)
# Nachricht schicken? ja / nein
WEBHOOK_BEI_ERFOLG=nein
# Die wichtigsten Fehlerzeilen mitschicken? ja / nein
# Werte in Anfuehrungszeichen, {...}-Inhalte, E-Mail- und IP-Adressen werden
# geschwaerzt; ganz ausschliessen laesst sich Personenbezug in Fehlermeldungen
# aber nicht. Bei einem fremden Dienst (z.B. ntfy.sh) ist das Auftrags-
# verarbeitung (DSGVO) - dann lieber eigener ntfy-Server oder "nein".
WEBHOOK_MIT_FEHLERAUSZUG=nein
