# Local operator file only: copy to .env and replace every REPLACE_ value.
# Existing database: use the existing credentials; do not change them just to deploy the proxy.
# PostgreSQL (service "postgres" in the root docker-compose.yml); the app uses the same values.
DB_USER=erp_user
DB_PASSWORD=REPLACE_WITH_EXISTING_OR_NEW_STRONG_DB_PASSWORD
# Existing installation: leave BOTH admin values empty; they do not update existing users.
# New installation: supply both values before the first private startup.
APP_ADMIN_USER=
APP_ADMIN_PASS=
ERP_PRIVATE_BIND_IP=127.0.0.1
ERP_UPSTREAM=app:8080
# Required only for the domain profile. DNS must already point at the server.
MOBILE_DOMAIN=mobile.invalid
# For a fixed domain use its HTTPS origin WITHOUT /zeiterfassung/ or a trailing slash.
ZEITERFASSUNG_URL=http://localhost:8080
MOBILE_PUBLIC_BIND_IP=0.0.0.0
